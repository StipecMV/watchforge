<Project>
  <!--
    WatchForge — Central Package Management (DRY)
    Všetky verzie NuGet balíkov sa spravujú TU, csproj referencujú len názov balíka.
    Pridanie balíka: tu zadefinuj verziu + pridaj PackageReference do csproj (bez Version).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ── Detekcia / počítačové videnie ─────────────────────────────── -->
    <!-- OpenCvSharp4 4.13.0.20260627: vyžaduje ho OpenCvSharp4.Cuda 1.0.4 -->
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageVersion Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />

    <!-- ── MCP (Sprint 7): Model Context Protocol server ─────────────── -->
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />

    <!-- GPU (Sprint 8): OpenCvSharp4.Cuda 1.0.4 + runtime linux-x64 Combined (Maxwell support) -->
    <PackageVersion Include="OpenCvSharp4.Cuda" Version="1.0.4" />
    <PackageVersion Include="OpenCvSharp4.Cuda.runtime.linux-x64" Version="1.0.8" />

    <!-- ── Testovanie (TUnit) ───────────────────────────────────────── -->
    <PackageVersion Include="TUnit" Version="1.19.74" />
    <PackageVersion Include="TUnit.Assertions" Version="1.19.74" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="8.0.1" />

    <!-- ── Hosting / konfigurácia (.NET) ────────────────────────────── -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="log4net" Version="3.3.1" />

    <!-- SQLite (Sprint 2): -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- NU1903 fix: 2.1.11 má známu zraniteľnosť (GHSA-2m69-gcr7-jv3q), 2.1.12 ju opravuje -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

    <!-- Face recognition (Sprint 8, Phase 2):
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    -->
  </ItemGroup>
</Project>
