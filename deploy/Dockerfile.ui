# WatchForge Web UI (kontajner 3 — Angular, statický build + nginx proxy /api)
FROM docker.io/oven/bun:1.3.14 AS build
WORKDIR /src

COPY applications/web/WatchForge.UI/package.json applications/web/WatchForge.UI/bun.lock ./
RUN bun install --frozen-lockfile

COPY applications/web/WatchForge.UI/ ./
RUN bun run build

FROM docker.io/nginx:alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/watchforgeclient/browser /usr/share/nginx/html
EXPOSE 80
